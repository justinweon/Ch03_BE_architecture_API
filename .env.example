# 복사해서 .env 로 사용하세요 (cp .env.example .env)
POSTGRES_USER=board
POSTGRES_PASSWORD=board_password
POSTGRES_DB=board

# 로컬 실행(uvicorn)용. docker-compose 의 api 서비스는 호스트를 db 로 덮어씀
DATABASE_URL=postgresql+psycopg://board:board_password@localhost:5433/board

# 반드시 배포 전에 변경: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
